# Backend selection (the swap is here, not in code)
HARNESS_LLM_BACKEND=fake          # fake | openai_compatible | azure
HARNESS_MEMORY_BACKEND=in_memory  # in_memory | pgvector (pgvector lands in a later phase)
HARNESS_TOOL_PARSER=native        # native | prompted

# OpenAI-compatible local server (llama.cpp llama-server / vLLM / any compatible endpoint)
# Only takes effect when HARNESS_LLM_BACKEND=openai_compatible above.
HARNESS_LLM_BASE_URL=http://localhost:8080/v1
HARNESS_LLM_MODEL=gemma4:a2b
HARNESS_LLM_API_KEY=              # leave blank; most local servers ignore it

# Azure OpenAI (cloud backend)
# Use the bare resource URL here, NOT whatever full sample URL the Azure AI Foundry portal
# shows on a given SDK/API tab (e.g. it may display .../openai/v1/responses for the newer
# Responses API — that path suffix breaks AsyncAzureOpenAI, which appends its own path).
HARNESS_AZURE_ENDPOINT=https://your-resource.openai.azure.com
HARNESS_AZURE_DEPLOYMENT=gpt-5.4-mini
HARNESS_AZURE_API_VERSION=2024-10-21
HARNESS_AZURE_API_KEY=            # leave blank to use managed identity

# pgvector long-term memory (Postgres DSN; may equal the checkpointer DSN).
# Leave blank until the pgvector backend is wired (Phase 5).
HARNESS_MEMORY_URL=

# RAG embeddings (mirrors HARNESS_LLM_BACKEND's swap pattern)
HARNESS_EMBEDDING_BACKEND=fake              # fake | openai_compatible | azure
HARNESS_EMBEDDING_BASE_URL=http://localhost:8081/v1  # second llama-server instance
HARNESS_EMBEDDING_MODEL=nomic-embed-text-v1.5
HARNESS_EMBEDDING_API_KEY=
# Must match the chosen embedding model's output size (e.g. text-embedding-3-small
# = 1536, -3-large = 3072) — it drives the vector-store schema, and changing it
# forces a reindex (ingest and query must share the same model/space).
HARNESS_EMBEDDING_DIMENSION=768

# Azure embeddings deployment (backend=azure only; reuses HARNESS_AZURE_ENDPOINT /
# HARNESS_AZURE_API_VERSION / HARNESS_AZURE_API_KEY from the chat backend above —
# same Azure resource, different deployment).
HARNESS_AZURE_EMBEDDING_DEPLOYMENT=

# RAG retrieval
HARNESS_RAG_K=5
HARNESS_RAG_PER_DOCUMENT_K=2   # max chunks per document; 0 = plain flat top-k
HARNESS_RAG_OVERFETCH=5        # candidate multiplier the quota selects from

# RAG vector stores
HARNESS_RAG_COLLECTION=papers
HARNESS_RAG_VECTOR_STORE_BACKEND=pgvector    # pgvector | milvus | in_memory
HARNESS_PGVECTOR_URL=postgresql://harness:harness@localhost:5432/harness
HARNESS_PGVECTOR_TABLE=rag_chunks
HARNESS_MILVUS_URI=./data/milvus_papers.db
HARNESS_MILVUS_COLLECTION=rag_chunks

# Wiki: the website agent's knowledge, loaded into memory at startup. Set one
# source: a local folder (this repo's gitignored wiki/, holding index.md), or a
# private Azure Blob container read with DefaultAzureCredential (`az login`
# locally, the Container App's managed identity in production). Restart the
# app after changing the wiki.
# HARNESS_WIKI_DIR=wiki
# HARNESS_WIKI_BLOB_ACCOUNT_URL=https://<account>.blob.core.windows.net
# HARNESS_WIKI_BLOB_CONTAINER=wiki
# HARNESS_WIKI_BLOB_PREFIX=

HARNESS_MAX_ITERATIONS=8

# Rate limiting (slowapi) — strict tier covers the LLM-invoking endpoints,
# default tier covers everything else except /health, which is never limited.
HARNESS_RATE_LIMIT_ENABLED=true       # true | false
HARNESS_RATE_LIMIT_STRICT=15/minute
HARNESS_RATE_LIMIT_DEFAULT=60/minute

# Authentication — gates every route except /health (and FastAPI's own
# /docs, /openapi.json, /redoc) behind one shared key. Fails closed: if
# enabled with no key set, the app refuses to start.
HARNESS_AUTH_ENABLED=true             # true | false
HARNESS_API_KEY=                      # generate with: openssl rand -hex 32

# Long-term memory (remember/recall) is a single shared store with no per-visitor
# partition. Off by default so a public deployment cannot leak one visitor's facts
# to another. Set true only for a single-operator deployment.
HARNESS_MEMORY_TOOLS_ENABLED=false    # true | false

# Tool arguments and results reach the browser (the chat stream and a thread's
# transcript) only when this is true; off, a browser gets each tool's name only.
# Off by default for a public site; turn it on for a single-operator deployment
# whose UI shows them (the harness's own UI).
HARNESS_SHOW_TOOL_DETAILS=false       # true | false

# The visitor session cookie (sid) is Secure by default: browsers only send it
# over HTTPS. Set false only for local development on a browser that does not
# treat http://localhost as a secure context.
HARNESS_SESSION_COOKIE_SECURE=true    # true | false

# Logging — level of the harness's own lines (harness.*), to stderr; every other
# library stays at WARNING. Never set an SDK's own debug switch in production
# (TYPESAFE_LOG_LEVEL=debug, OPENAI_LOG=debug, LANGFUSE_DEBUG=true), nor run
# uvicorn with --log-level trace: they log visitor messages, the sid cookie or
# the API key.
HARNESS_LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR

# Input guard — TypeSafe (Jev) screens every chat message before the agent sees
# it. On by default and fails closed: with no key set, the app refuses to
# start. A single-operator deployment turns it off (and the limits below to 0).
HARNESS_INPUT_GUARD_ENABLED=true      # true | false
HARNESS_TYPESAFE_API_KEY=             # from console.typesafe.ai
# Fixed limits, each off at 0; the defaults are the public website's values.
HARNESS_MAX_MESSAGE_CHARS=2000
HARNESS_MAX_OUTPUT_TOKENS=1500        # per LLM call
HARNESS_MAX_THREAD_TURNS=20           # runs per thread
HARNESS_DAILY_TOKEN_BUDGET=33000      # all visitors per UTC day: monthly quota / 30

# Browser origins allowed to call the API directly (comma-separated). This
# repo's own SPA doesn't need it in production — it talks to Caddy same-origin,
# where CORS doesn't apply — but it's load-bearing for any other origin calling
# this API directly. Not HARNESS_-prefixed (predates that convention).
CORS_ORIGINS=http://localhost:5173

# --- Track 1: LiteLLM proxy -------------------------------------------------
# The harness talks ONLY to the proxy; providers are configured in
# litellm_config.yaml. Profile names: ollama-gemma | ollama-gemma-12b | claude
# | gpt | gemini-flash | deepseek-flash
#
# This is the actual daily-driver setup, but it's commented out here because it
# reuses HARNESS_LLM_BACKEND / HARNESS_LLM_BASE_URL / HARNESS_LLM_API_KEY from
# above — dotenv keeps the LAST value for a duplicate key, so having both live
# at once silently picks whichever block comes later, no error or warning.
# To activate: comment out those three keys (and HARNESS_LLM_MODEL, unused by
# this backend) up top, then uncomment the four lines below instead.
# HARNESS_LLM_BACKEND=openai_compatible
# HARNESS_LLM_BASE_URL=http://localhost:4000/v1
# HARNESS_LLM_API_KEY=sk-litellm-master        # must equal LITELLM_MASTER_KEY
# HARNESS_DEFAULT_MODEL=ollama-gemma

LITELLM_MASTER_KEY=sk-litellm-master
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# --- Track 1: Langfuse (cloud) -----------------------------------------------
# Self-hosting pulls in ClickHouse/Redis/MinIO for a tool only one person (or
# a few site visitors) uses — not worth the overhead. Sign up at
# https://cloud.langfuse.com/auth/sign-up, create a project, create API
# credentials in its project settings, paste them below. Empty keys = tracing
# disabled, chat unaffected either way (fire-and-forget, see devlog 009).
# EU region shown; US region host: https://us.cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
